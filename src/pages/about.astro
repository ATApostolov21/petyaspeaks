---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Divider from "../components/Divider.astro";
import AnimatedHeading from "../components/AnimatedHeading.astro";
import PortableText from "../components/PortableText.astro";
import SanityImage from "../components/SanityImage.astro";
import EmptyState from "../components/EmptyState.astro";
import { getAuthor, getPress, formatDate } from "../lib/sanity";

const [author, press] = await Promise.all([getAuthor(), getPress()]);
---

<Layout title="За мен" description={author?.tagline}>
  <Nav />

  <main>
    {
      author ? (
        <>
          <!-- Portrait + intro -->
          <section class="wash relative mx-auto max-w-5xl px-6 pb-16 pt-16 md:pt-24">
            <div class="grid items-center gap-12 md:grid-cols-[minmax(0,320px)_1fr] md:gap-16">
              <div class="reveal mx-auto w-full max-w-xs md:mx-0">
                <div class="shadow-warm aspect-[4/5] w-full overflow-hidden rounded-sm bg-muted">
                  <SanityImage image={author.profileImage} alt={author.name} width={480} />
                </div>
              </div>
              <div class="reveal reveal-d1">
                <p class="mb-3 font-serif text-sm uppercase tracking-widest text-accent">За мен</p>
                <AnimatedHeading
                  text={author.name}
                  class="mb-5 font-display text-4xl leading-tight text-ink md:text-5xl"
                />
                <p class="font-hand text-3xl leading-snug text-ink/80 md:text-4xl">
                  {author.tagline}
                </p>
              </div>
            </div>
          </section>

          {author.bio && author.bio.length > 0 && (
            <section class="mx-auto max-w-2xl px-6 py-12">
              <PortableText
                value={author.bio}
                class="reveal text-lg leading-relaxed text-ink/85"
              />
            </section>
          )}

          <div class="reveal py-8">
            <Divider />
          </div>
        </>
      ) : (
        <EmptyState message="Профилът предстои — ще се появи тук веднага щом бъде попълнен в Sanity Studio." />
      )
    }

    <!-- Press -->
    <section class="mx-auto max-w-3xl px-6 pb-24 pt-4">
      {press.length > 0 && (
        <>
          <h2 class="reveal mb-10 text-center font-display text-2xl text-ink md:text-3xl">
            Публикации за мен
          </h2>
          <ul class="divide-y divide-ink/10">
            {press.map((item, i) => (
              <li class={`reveal reveal-d${Math.min(i + 1, 3)} py-6`}>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover-card group -m-4 flex flex-col gap-1.5 p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
                >
                  <div>
                    <p class="hover-card-eyebrow mb-1 font-serif text-xs uppercase tracking-widest text-accent">
                      {item.mediaName} · {formatDate(item.publishedAt)}
                    </p>
                    <h3 class="hover-card-title font-display text-lg text-ink">
                      {item.title}
                    </h3>
                    <p class="hover-card-body mt-1 leading-relaxed text-ink/70">{item.description}</p>
                  </div>
                  <span
                    class="hover-card-cta shrink-0 text-ink/40 transition-transform duration-300 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  </main>

  <Footer />
</Layout>
