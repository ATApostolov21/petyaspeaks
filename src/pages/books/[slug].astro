---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Divider from "../../components/Divider.astro";
import AnimatedHeading from "../../components/AnimatedHeading.astro";
import PortableText from "../../components/PortableText.astro";
import SanityImage from "../../components/SanityImage.astro";
import { getBooks } from "../../lib/sanity";

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
---

<Layout title={book.title} description={book.description}>
  <Nav />

  <main>
    <section class="wash mx-auto max-w-5xl px-6 pb-16 pt-16 md:pt-24">
      <a
        href="/books"
        class="reveal mb-10 inline-flex items-center gap-1.5 font-serif text-sm text-ink/60 transition-colors hover:text-accent"
      >
        ← Всички книги
      </a>
      <div class="grid gap-12 md:grid-cols-[minmax(0,340px)_1fr] md:gap-16">
        <div class="reveal mx-auto w-full max-w-sm md:mx-0">
          <div class="shadow-warm group aspect-[3/4] w-full overflow-hidden rounded-sm bg-muted">
            <SanityImage image={book.coverImage} alt={book.title} width={640} />
          </div>
        </div>
        <div class="reveal reveal-d1">
          <AnimatedHeading
            text={book.title}
            class="mb-5 font-display text-4xl leading-tight text-ink md:text-5xl"
          />
          <p class="mb-8 text-lg leading-relaxed text-ink/80">{book.description}</p>
          <a
            href={book.purchaseUrl || "#"}
            class="btn-primary inline-block rounded-sm px-7 py-3 font-serif text-sm tracking-wide text-paper"
          >
            Поръчай книгата
          </a>
        </div>
      </div>
    </section>

    {
      book.annotation && book.annotation.length > 0 && (
        <>
          <div class="reveal py-4">
            <Divider />
          </div>

          <!-- Annotation -->
          <section class="mx-auto max-w-2xl px-6 py-12">
            <h2 class="reveal mb-8 text-center font-display text-2xl text-ink">Анотация</h2>
            <PortableText
              value={book.annotation}
              class="reveal text-lg leading-relaxed text-ink/85"
            />
          </section>
        </>
      )
    }

    {
      book.excerpts && book.excerpts.length > 0 && (
        <section class="relative overflow-hidden bg-muted/60">
          <div class="mx-auto max-w-2xl px-6 py-16">
            <h2 class="reveal mb-10 text-center font-display text-2xl text-ink">Откъси</h2>
            <div class="space-y-10">
              {book.excerpts.map((excerpt, i) => (
                <blockquote
                  class={`reveal reveal-d${Math.min(i + 1, 3)} border-l-2 border-accent/40 pl-6`}
                >
                  <p class="font-display text-xl italic leading-relaxed text-ink/90">{excerpt}</p>
                </blockquote>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="mx-auto max-w-2xl px-6 py-16 text-center">
      <a
        href={book.purchaseUrl || "#"}
        class="btn-primary reveal inline-block rounded-sm px-8 py-3.5 font-serif text-sm tracking-wide text-paper"
      >
        Поръчай книгата
      </a>
    </section>
  </main>

  <Footer />
</Layout>
