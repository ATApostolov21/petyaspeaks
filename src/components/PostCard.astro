---
import { categoryLabels, categoryColors, formatDate, type Post } from "../lib/sanity";

interface Props {
  post: Post;
  class?: string;
}

const { post, class: className = "" } = Astro.props;
const color = categoryColors[post.category];
---

<article class:list={["group reveal", className]}>
  <a href={`/blog/${post.slug}`} class="block">
    <p class:list={["mb-2 font-serif text-xs uppercase tracking-widest", color.text]}>
      {categoryLabels[post.category]} · {formatDate(post.publishedAt)}
    </p>
    <h3
      class:list={[
        "mb-2 font-display text-xl text-ink transition-colors",
        color.groupHoverText,
      ]}
    >
      {post.title}
    </h3>
    <p class="mb-3 leading-relaxed text-ink/70">{post.excerpt}</p>
    <span
      class:list={[
        "inline-flex items-center gap-1.5 text-sm text-ink/50 transition-colors",
        color.groupHoverText,
      ]}
    >
      Прочети
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </a>
</article>
