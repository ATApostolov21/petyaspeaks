---
import { categoryLabels, categoryColors, formatDate, type Post } from "../lib/sanity";

interface Props {
  post: Post;
  class?: string;
}

const { post, class: className = "" } = Astro.props;
const color = categoryColors[post.category];
---

<article class:list={["group reveal", className]}>
  {
    /*
      No --hover-from/--hover-to override here — this card defaults to the
      site's wine hover (global.css's fallback) everywhere by default, e.g.
      the homepage and the blog's "Всички" view. blog/index.astro overrides
      those variables on this card's [data-category] wrapper, but only
      while that category's own filter tab is selected — so a post only
      hovers in its own color once you've actually filtered down to it.
    */
  }
  <a href={`/blog/${post.slug}`} class="hover-card -m-6 block p-6">
    <p class:list={["hover-card-eyebrow mb-2 font-serif text-xs uppercase tracking-widest", color.text]}>
      {categoryLabels[post.category]} · {formatDate(post.publishedAt)}
    </p>
    <h3 class="hover-card-title mb-2 font-display text-xl text-ink">
      {post.title}
    </h3>
    <p class="hover-card-body mb-3 leading-relaxed text-ink/70">{post.excerpt}</p>
    <span class="hover-card-cta inline-flex items-center gap-1.5 text-sm text-ink/50">
      Прочети
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </a>
</article>
