---
/**
 * Decorative line-art botanical flourish. Pure SVG, no images.
 * Strokes use `currentColor`, so wrap with a Tailwind text-color
 * utility (e.g. text-accent/30) to match it to the palette.
 *
 * Each path/circle uses pathLength="1" so stroke-dasharray/-dashoffset
 * can be driven with plain CSS (see .draw-path in global.css) — no
 * per-flower JS needed. The wrapper reuses the site's existing
 * `.reveal` scroll-observer, so the flower "draws itself" the moment
 * it enters the viewport.
 */
interface Props {
  variant?: "bloom" | "sprig" | "branch";
  class?: string;
  delay?: 0 | 1 | 2 | 3;
}

const { variant = "bloom", class: className = "", delay = 0 } = Astro.props;
const petalAngles = [0, 60, 120, 180, 240, 300];
---

<div
  class:list={["reveal pointer-events-none select-none", `reveal-d${delay}`, className]}
  aria-hidden="true"
>
  {
    variant === "bloom" && (
      <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path
          class="draw-path"
          style="transition-delay:0.55s"
          d="M100,107 C 93,138 107,166 97,197"
        />
        <path
          class="draw-path"
          style="transition-delay:0.65s"
          transform="translate(84,146) rotate(160)"
          d="M0,0 C 8,-8 22,-8 30,0 C 22,8 8,8 0,0 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.72s"
          transform="translate(114,170) rotate(-25)"
          d="M0,0 C 8,-8 22,-8 30,0 C 22,8 8,8 0,0 Z"
        />
        {petalAngles.map((angle, i) => (
          <path
            class="draw-path"
            style={`transition-delay:${i * 0.09}s`}
            transform={`rotate(${angle} 100 100)`}
            d="M100,100 C 86,78 86,48 100,28 C 114,48 114,78 100,100 Z"
          />
        ))}
        <circle class="draw-path" style="transition-delay:0.85s" cx="100" cy="100" r="7" />
      </svg>
    )
  }
  {
    variant === "sprig" && (
      <svg viewBox="0 0 100 240" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path class="draw-path" style="transition-delay:0s" d="M50,230 C 40,170 60,110 50,22" />
        <path
          class="draw-path"
          style="transition-delay:0.25s"
          transform="translate(50,196) rotate(150)"
          d="M0,0 C 7,-7 20,-7 28,0 C 20,7 7,7 0,0 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.35s"
          transform="translate(50,150) rotate(-30)"
          d="M0,0 C 7,-7 20,-7 28,0 C 20,7 7,7 0,0 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.45s"
          transform="translate(50,104) rotate(150)"
          d="M0,0 C 7,-7 20,-7 28,0 C 20,7 7,7 0,0 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.6s"
          d="M50,36 C 40,27 40,9 50,0 C 60,9 60,27 50,36 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.7s"
          transform="rotate(-32 50 20)"
          d="M50,36 C 40,27 40,9 50,0 C 60,9 60,27 50,36 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.78s"
          transform="rotate(32 50 20)"
          d="M50,36 C 40,27 40,9 50,0 C 60,9 60,27 50,36 Z"
        />
      </svg>
    )
  }
  {
    variant === "branch" && (
      <svg viewBox="0 0 340 140" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path
          class="draw-path"
          style="transition-delay:0s"
          d="M6,78 C 90,55 160,100 200,70 C 240,45 290,65 334,48"
        />
        <path
          class="draw-path"
          style="transition-delay:0.3s"
          transform="translate(64,66) rotate(-70)"
          d="M0,0 C 7,-7 20,-7 28,0 C 20,7 7,7 0,0 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.38s"
          transform="translate(150,96) rotate(110)"
          d="M0,0 C 7,-7 20,-7 28,0 C 20,7 7,7 0,0 Z"
        />
        <path
          class="draw-path"
          style="transition-delay:0.46s"
          transform="translate(238,52) rotate(-60)"
          d="M0,0 C 7,-7 20,-7 28,0 C 20,7 7,7 0,0 Z"
        />
        {[0, 90, 180, 270].map((angle, i) => (
          <path
            class="draw-path"
            style={`transition-delay:${0.6 + i * 0.08}s`}
            transform={`translate(30,72) rotate(${angle})`}
            d="M0,0 C -6,-14 -6,-24 0,-32 C 6,-24 6,-14 0,0 Z"
          />
        ))}
        <circle class="draw-path" style="transition-delay:0.95s" cx="30" cy="72" r="4" />
        {[0, 90, 180, 270].map((angle, i) => (
          <path
            class="draw-path"
            style={`transition-delay:${0.6 + i * 0.08}s`}
            transform={`translate(308,44) rotate(${angle})`}
            d="M0,0 C -5,-11 -5,-19 0,-25 C 5,-19 5,-11 0,0 Z"
          />
        ))}
        <circle class="draw-path" style="transition-delay:0.95s" cx="308" cy="44" r="3" />
      </svg>
    )
  }
</div>
