---
interface Props {
  message?: string;
}

const { message = "Съдържанието предстои — ще се появи тук веднага щом бъде добавено в Sanity Studio." } =
  Astro.props;
---

<div class="reveal mx-auto max-w-md py-16 text-center">
  <p class="font-display text-lg italic leading-relaxed text-ink/50">
    {message}
  </p>
</div>
