---
import { getAuthor } from "../lib/sanity";

const author = await getAuthor();
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-gradient-border mx-auto max-w-5xl px-6 py-14">
    <div class="flex flex-col items-center gap-6 text-center">
      {
        author?.tagline && (
          <p class="max-w-md font-hand text-2xl leading-snug text-ink/80">
            {author.tagline}
          </p>
        )
      }

      {
        (author?.instagramUrl || author?.facebookUrl) && (
          <div class="flex items-center gap-4">
            {author.instagramUrl && (
              <a
                href={author.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink/60 transition-colors hover:border-accent hover:text-accent"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                </svg>
              </a>
            )}
            {author.facebookUrl && (
              <a
                href={author.facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink/60 transition-colors hover:border-accent hover:text-accent"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13.5 21v-8.2h2.75l.41-3.2h-3.16V7.4c0-.93.26-1.56 1.6-1.56h1.7V2.98A22.7 22.7 0 0 0 14.3 2.8c-2.63 0-4.43 1.6-4.43 4.55v2.25H7.1v3.2h2.77V21h3.63Z" />
                </svg>
              </a>
            )}
          </div>
        )
      }

      <div class="flex gap-6 font-serif text-xs uppercase tracking-widest text-ink/50">
        <a href="/" class="transition-colors hover:text-accent">Начало</a>
        <a href="/about" class="transition-colors hover:text-accent">За мен</a>
        <a href="/books" class="transition-colors hover:text-accent">Книги</a>
        <a href="/blog" class="transition-colors hover:text-accent">Блог</a>
        <a href="/contact" class="transition-colors hover:text-accent">Контакти</a>
      </div>

      <p class="text-xs text-ink/40">&copy; {year} {author?.name ?? "Petya Speaks"}. Всички права запазени.</p>
    </div>
  </div>
</footer>
