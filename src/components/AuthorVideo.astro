---
/**
 * Evergreen "about the author" visual — not tied to any specific book,
 * so it never goes stale when a new one is published. Plays only once
 * scrolled into view (see initVideoAutoplay in Layout.astro) and never
 * autoplays under prefers-reduced-motion — the poster frame alone
 * already reads as a normal still photo in that case.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<video
  data-autoplay-on-view
  muted
  loop
  playsinline
  preload="metadata"
  poster="/media/author-pier-poster.jpg"
  class:list={["h-full w-full object-cover", className]}
>
  <source src="/media/author-pier.mp4" type="video/mp4" />
</video>
