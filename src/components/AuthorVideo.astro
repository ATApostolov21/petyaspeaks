---
/**
 * Brand motif for the "about the author" section — an animated version
 * of the watercolor wave circle from the book's own cover art, rather
 * than a literal photo/video of her. Plays only once scrolled into view
 * (see initVideoAutoplay in Layout.astro) and never autoplays under
 * prefers-reduced-motion — the poster frame alone already reads as a
 * normal still image in that case.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<video
  data-autoplay-on-view
  muted
  loop
  playsinline
  preload="metadata"
  poster="/media/wave-circle-poster.jpg"
  class:list={[
    // The painted circle isn't centered in its 1440x1440 frame (measured
    // bounding box: left 175, right 1273, top 134, bottom 1253 — center
    // sits ~26px above and ~4px right of the frame's own center). Scaling
    // around the frame's center, the binding constraint is the bottom
    // edge (720/533 ≈ 1.351 minimum needed to reach it) — 1.32 fell just
    // short there, leaving a sliver of white showing through the crop.
    // 1.4 clears all four edges with a bit of margin to spare.
    "h-full w-full scale-[1.4] object-cover",
    className,
  ]}
>
  <source src="/media/wave-circle.mp4" type="video/mp4" />
</video>
