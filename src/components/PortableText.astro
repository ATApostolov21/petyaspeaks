---
import { toHTML } from "@portabletext/to-html";
import type { PortableTextBlock } from "@portabletext/to-html";
import { urlFor } from "../lib/sanity";

interface Props {
  value?: PortableTextBlock[];
  class?: string;
}

const { value = [], class: className = "" } = Astro.props;

const html = toHTML(value, {
  components: {
    block: {
      normal: ({ children }) => `<p>${children}</p>`,
      blockquote: ({ children }) =>
        `<blockquote class="border-l-2 border-accent/40 pl-6 font-display text-xl italic text-ink/90">${children}</blockquote>`,
      h2: ({ children }) => `<h2 class="mt-4 font-display text-2xl text-ink">${children}</h2>`,
      h3: ({ children }) => `<h3 class="mt-4 font-display text-xl text-ink">${children}</h3>`,
    },
    marks: {
      strong: ({ children }) => `<strong class="text-ink">${children}</strong>`,
      em: ({ children }) => `<em>${children}</em>`,
      link: ({ children, value: linkValue }) =>
        `<a href="${(linkValue as { href?: string })?.href ?? "#"}" class="text-accent underline underline-offset-2 transition-colors hover:text-accent-hover" target="_blank" rel="noopener noreferrer">${children}</a>`,
    },
    list: {
      bullet: ({ children }) => `<ul class="list-disc space-y-2 pl-6">${children}</ul>`,
      number: ({ children }) => `<ol class="list-decimal space-y-2 pl-6">${children}</ol>`,
    },
    listItem: {
      bullet: ({ children }) => `<li>${children}</li>`,
      number: ({ children }) => `<li>${children}</li>`,
    },
    types: {
      image: ({ value: imageValue }) =>
        `<img src="${urlFor(imageValue).width(1200).url()}" alt="" class="my-6 w-full rounded-sm" loading="lazy" />`,
    },
  },
});
---

<div class:list={["rich-text", className]} set:html={html} />
