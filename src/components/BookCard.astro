---
import type { Book } from "../lib/sanity";
import SanityImage from "./SanityImage.astro";

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<article class="reveal group">
  <a href={`/books/${book.slug}`} class="block">
    <div class="shadow-warm-sm mb-5 aspect-[3/4] w-full overflow-hidden rounded-sm bg-muted transition-shadow duration-500 group-hover:shadow-warm">
      <SanityImage image={book.coverImage} alt={book.title} width={480} />
    </div>
    <div class="hover-card -m-4 p-4">
      <h3 class="hover-card-title mb-1.5 font-display text-xl text-ink">
        {book.title}
      </h3>
      <p class="hover-card-body mb-3 leading-relaxed text-ink/70">{book.description}</p>
      <span class="hover-card-cta inline-flex items-center gap-1.5 text-sm text-ink/50">
        Разгледай
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </span>
    </div>
  </a>
</article>
